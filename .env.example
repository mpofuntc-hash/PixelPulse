# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
# Private chat ID (not the public channel) where steam-bot.js sends trade confirmation alerts.
# Get yours by messaging @userinfobot on Telegram.
TELEGRAM_ADMIN_CHAT_ID=your_personal_telegram_chat_id

# Steam Trade Bot (CS2 skins escrow)
STEAM_BOT_USERNAME=your_steam_bot_username
STEAM_BOT_PASSWORD=your_steam_bot_password
# Optional: only needed for full automation (instant trade confirmation). See DEPLOYMENT.md.
STEAM_BOT_SHARED_SECRET=
STEAM_BOT_IDENTITY_SECRET=
# Optional: only used for cosmetic Steam username/avatar display + inventory verification endpoint.
STEAM_API_KEY=

# Live prediction data
# PandaScore enables verified CS2, Valorant, LoL and Dota 2 fixtures. Leave it
# empty until you have a key; the site will disclose that esports data is off.
PANDASCORE_API_KEY=your_pandascore_api_key
# Do not change this to real-money operation without the required approvals.
PREDICTION_MODE=credits

# OwnPayment
OWNPAY_IPN_KEY=your_ipn_key
OWNPAY_API_KEY=your_api_key
OWNPAY_PUBLIC_KEY=your_public_key
OWNPAY_BASE_URL=https://api.ownpayment.com

# BTCPay Server (alternative to OwnPayment)
BTCPAY_URL=https://your-btcpay-server.com
BTCPAY_STORE_ID=your_store_id
BTCPAY_API_KEY=your_api_key

# BTC Wallet
BTC_WALLET_ADDRESS=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh

# Database
DATABASE_URL=postgres://user:password@host:port/database

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=pixelpulse-videos

# Pricing (in cents)
MONTHLY_PRICE=5000  # R50
QUARTERLY_PRICE=15000  # R150
YEARLY_PRICE=50000  # R500

# Facebook Page Bot
# Get a Page Access Token from https://developers.facebook.com/tools/explorer
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FB_GRAPH_VERSION=v18.0

# Server
PORT=3000
